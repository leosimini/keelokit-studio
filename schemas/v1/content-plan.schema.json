{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelokit.com/studio/schemas/v1/content-plan.schema.json",
  "title": "Keelokit Studio content plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "plan_id", "version", "suites", "pending", "out_of_scope"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "source_brief": {"type": "object", "additionalProperties": false, "required": ["version", "hash"], "properties": {"version": {"type": "integer", "minimum": 1}, "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite_id", "objective", "priority", "dependencies", "budget", "pieces", "review_criteria"],
        "properties": {
          "suite_id": {"type": "string", "minLength": 1},
          "objective": {"enum": ["discovery", "evaluation", "activation", "use", "retention", "news"]},
          "priority": {"type": "integer", "minimum": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "budget": {"type": ["number", "null"], "minimum": 0},
          "review_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "pieces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["piece_id", "audience_id", "intention", "cta", "message", "evidence_ids", "evidence_requirements", "structure", "duration_seconds", "formats", "language", "channels", "order", "dependencies", "requirements", "review_criteria", "estimated_cost"],
              "properties": {
                "piece_id": {"type": "string", "minLength": 1},
                "audience_id": {"type": "string", "minLength": 1},
                "intention": {"type": "string", "minLength": 1},
                "cta": {"type": "string", "minLength": 1},
                "message": {"type": "string", "minLength": 1},
                "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "evidence_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
                "structure": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
                "formats": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "language": {"type": "string", "minLength": 1},
                "channels": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "order": {"type": "integer", "minimum": 1},
                "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "review_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "estimated_cost": {"type": ["number", "null"], "minimum": 0}
              }
            }
          }
        }
      }
    },
    "pending": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}

