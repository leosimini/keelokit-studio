{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelokit.com/studio/schemas/v1/content-plan.schema.json",
  "title": "Keelokit Studio content plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "plan_id", "version", "suites"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite_id", "objective", "priority", "dependencies", "pieces", "review_criteria"],
        "properties": {
          "suite_id": {"type": "string", "minLength": 1},
          "objective": {"enum": ["discovery", "evaluation", "activation", "use", "retention", "news"]},
          "priority": {"type": "integer", "minimum": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "budget": {"type": ["number", "null"], "minimum": 0},
          "review_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "pieces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["piece_id", "audience_id", "intention", "cta", "message", "evidence_ids", "formats", "language", "channels", "dependencies"],
              "properties": {
                "piece_id": {"type": "string", "minLength": 1},
                "audience_id": {"type": "string", "minLength": 1},
                "intention": {"type": "string", "minLength": 1},
                "cta": {"type": "string", "minLength": 1},
                "message": {"type": "string", "minLength": 1},
                "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "formats": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "language": {"type": "string", "minLength": 1},
                "channels": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "estimated_cost": {"type": ["number", "null"], "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}

