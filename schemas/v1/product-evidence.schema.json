{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelokit.com/studio/schemas/v1/product-evidence.schema.json",
  "title": "Keelokit Studio product evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "feature_or_journey", "procedure_hash", "surface", "adapter", "verification", "role", "availability", "flags", "build", "locale", "steps", "result", "capture_paths", "hashes", "allowed_claims"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "feature_or_journey": {"type": "string", "minLength": 1},
          "procedure_hash": {"type": "string", "minLength": 1},
          "surface": {"enum": ["web", "native", "desktop", "cli", "api", "provided-material"]},
          "adapter": {"enum": ["playwright-web", "adb-android", "simctl-ios", "cli", "api", "provided-material"]},
          "verification": {"enum": ["live-capture", "configured-unavailable", "screenshot-only", "reproducible-request", "provenance-limited"]},
          "role": {"type": "string", "minLength": 1},
          "availability": {"enum": ["available", "disabled", "failed", "unknown"]},
          "flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "build": {"type": "string", "minLength": 1},
          "commit": {"type": ["string", "null"]},
          "locale": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "result": {"type": "string", "minLength": 1},
          "capture_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "hashes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "allowed_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "allOf": [
          {
            "if": {"properties": {"availability": {"not": {"const": "available"}}}},
            "then": {"properties": {"allowed_claims": {"type": "array", "maxItems": 0}}}
          },
          {
            "if": {"properties": {"surface": {"enum": ["web", "native", "desktop"]}}},
            "then": {"properties": {"verification": {"enum": ["live-capture", "configured-unavailable", "screenshot-only"]}}}
          },
          {
            "if": {"properties": {"verification": {"const": "screenshot-only"}}},
            "then": {"properties": {"surface": {"const": "native"}, "allowed_claims": {"type": "array", "maxItems": 0}}}
          },
          {
            "if": {"properties": {"adapter": {"const": "adb-android"}}},
            "then": {"properties": {"surface": {"const": "native"}, "verification": {"enum": ["live-capture", "configured-unavailable"]}}}
          },
          {
            "if": {"properties": {"adapter": {"const": "simctl-ios"}}},
            "then": {"properties": {"surface": {"const": "native"}, "verification": {"enum": ["screenshot-only", "configured-unavailable"]}}}
          },
          {
            "if": {"properties": {"surface": {"enum": ["cli", "api"]}}},
            "then": {"properties": {"verification": {"const": "reproducible-request"}}}
          },
          {
            "if": {"properties": {"surface": {"const": "provided-material"}}},
            "then": {"properties": {"verification": {"const": "provenance-limited"}}}
          },
          {
            "if": {"properties": {"verification": {"const": "configured-unavailable"}}},
            "then": {
              "properties": {
                "availability": {"enum": ["disabled", "failed", "unknown"]},
                "allowed_claims": {"type": "array", "maxItems": 0}
              }
            }
          },
          {
            "if": {"properties": {"adapter": {"const": "playwright-web"}}},
            "then": {"properties": {"surface": {"const": "web"}, "verification": {"enum": ["live-capture", "configured-unavailable"]}}}
          },
          {
            "if": {"properties": {"adapter": {"const": "cli"}}},
            "then": {"properties": {"surface": {"const": "cli"}, "verification": {"const": "reproducible-request"}}}
          },
          {
            "if": {"properties": {"adapter": {"const": "api"}}},
            "then": {"properties": {"surface": {"const": "api"}, "verification": {"const": "reproducible-request"}}}
          },
          {
            "if": {"properties": {"adapter": {"const": "provided-material"}}},
            "then": {"properties": {"surface": {"const": "provided-material"}, "verification": {"const": "provenance-limited"}}}
          }
        ]
      }
    }
  }
}

