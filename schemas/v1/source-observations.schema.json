{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelokit.com/studio/schemas/v1/source-observations.schema.json",
  "title": "Keelokit Studio source observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "kind", "location", "observed_at", "build", "status", "content_hash", "availability_evidence"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^source-[a-f0-9]{16}$"},
          "kind": {"enum": ["profile", "readme", "context", "prd", "completed-work", "changelog", "manual", "brand", "ui", "build", "environment", "journey", "backlog", "provided-material"]},
          "location": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
          "build": {"type": ["string", "null"]},
          "status": {"enum": ["confirmed", "inferred", "contradictory", "stale", "missing"]},
          "content_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "availability_evidence": {"enum": ["candidate", "none"]}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"enum": ["readme", "backlog"]}}, "required": ["kind"]},
            "then": {"properties": {"availability_evidence": {"const": "none"}}}
          },
          {
            "if": {"properties": {"status": {"const": "missing"}}, "required": ["status"]},
            "then": {"properties": {"content_hash": {"const": null}, "availability_evidence": {"const": "none"}}},
            "else": {"properties": {"content_hash": {"type": "string"}}}
          }
        ]
      }
    }
  }
}

