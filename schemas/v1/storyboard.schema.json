{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelokit.com/studio/schemas/v1/storyboard.schema.json",
  "title": "Keelokit Studio storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "piece_id", "audience_id", "intention", "cta", "formats", "fps", "duration_seconds", "scenes"],
  "properties": {
    "schema_version": {"const": 1},
    "storyboard_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "plan_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "plan_scope": {"type": "string", "minLength": 1},
    "intent_type": {"enum": ["explainer", "tutorial", "custom"]},
    "message": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "structure": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"$ref": "#/$defs/strings"},
    "preconditions": {"$ref": "#/$defs/strings"},
    "steps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "structure_justification": {"type": ["string", "null"], "minLength": 1},
    "evidence_target": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_or_journey", "surface", "role", "build", "locale", "flags", "availability"],
      "properties": {
        "feature_or_journey": {"type": "string", "minLength": 1},
        "surface": {"enum": ["web", "native", "desktop", "cli", "api", "provided-material"]},
        "role": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 1},
        "flags": {"$ref": "#/$defs/strings"},
        "availability": {"const": "available"},
        "commit": {"type": ["string", "null"]}
      }
    },
    "project_id": {"type": "string", "minLength": 1},
    "piece_id": {"type": "string", "minLength": 1},
    "audience_id": {"type": "string", "minLength": 1},
    "intention": {"type": "string", "minLength": 1},
    "cta": {"type": "string", "minLength": 1},
    "formats": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "start_seconds", "end_seconds", "narration", "on_screen_text", "asset_ids", "evidence_ids"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "section": {"type": "string", "minLength": 1},
          "step": {"type": ["string", "null"], "minLength": 1},
          "claims": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["claim", "evidence_id"],
              "properties": {"claim": {"type": "string", "minLength": 1}, "evidence_id": {"type": "string", "minLength": 1}}
            }
          },
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "narration": {"type": "string"},
          "on_screen_text": {"type": "string"},
          "asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    }
  },
  "$defs": {"strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
  "allOf": [{
    "if": {"properties": {"version": {}}, "required": ["version"]},
    "then": {
      "required": ["storyboard_id", "plan_id", "plan_version", "plan_hash", "plan_scope", "intent_type", "message", "language", "structure", "evidence_ids", "preconditions", "steps", "structure_justification", "evidence_target"],
      "properties": {
        "storyboard_id": {}, "plan_id": {}, "plan_version": {}, "plan_hash": {}, "plan_scope": {}, "intent_type": {}, "message": {}, "language": {}, "preconditions": {}, "steps": {}, "structure_justification": {}, "evidence_target": {},
        "evidence_ids": {"type": "array", "minItems": 1}, "structure": {"type": "array", "minItems": 1},
        "scenes": {"type": "array", "items": {"type": "object", "properties": {"section": {}, "step": {}, "claims": {}}, "required": ["section", "step", "claims"]}}
      }
    }
  }]
}

