{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelokit.com/studio/schemas/v1/audiences.schema.json",
  "title": "Keelokit Studio audiences",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "audiences"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience_id", "public_name", "jobs", "stage", "vocabulary", "objections", "related_roles", "ctas", "source_ids", "confirmation_status"],
        "properties": {
          "audience_id": {"type": "string", "minLength": 1},
          "public_name": {"type": "string", "minLength": 1},
          "jobs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "stage": {"enum": ["discovery", "evaluation", "activation", "use", "retention", "news"]},
          "vocabulary": {"type": "array", "items": {"type": "string"}},
          "objections": {"type": "array", "items": {"type": "string"}},
          "related_roles": {"type": "array", "items": {"type": "string"}},
          "ctas": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "confirmation_status": {"enum": ["proposed", "confirmed", "rejected"]}
        }
      }
    }
  }
}

